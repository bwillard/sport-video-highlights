# Copy to .env and fill in real paths. .env is gitignored.
SOCCER_FULL_DIR=/path/to/soccer/full
SOCCER_PROXY_DIR=/path/to/soccer/proxy
SOCCER_CLIPS_DIR=/path/to/soccer/clips
SOCCER_GAMES_DIR=/path/to/soccer/games
SOCCER_REELS_DIR=/path/to/soccer/reels
SOCCER_GALLERY_DIR=/path/to/soccer/player_gallery
# Tracking benchmark clips (optional; defaults to a "bench" folder next to SOCCER_GAMES_DIR)
# SOCCER_BENCH_DIR=/path/to/soccer/bench
SOCCER_HOST=0.0.0.0
SOCCER_PORT=8000
# Jersey number the F key tags in the tagger (optional)
SOCCER_DEFAULT_PLAYER=
# FFMPEG=/path/to/ffmpeg

# ---- Reel render speed and quality (full 1080p renders; previews are always quick CPU) ----
# Which encoder: auto = the GPU if it works, else the CPU; gpu = GPU or fail; cpu = CPU only.
SOCCER_ENCODER=auto
# SOCCER_GPU_DEVICE=/dev/dri/renderD128
#
# Quality: lower number = better picture and bigger file. Changing it re-encodes
# every clip on the next render (cached pieces only match their own settings).
# Measured on a minute of real Veo footage (the original is 35 MB/min).
# "Match" is how close it is to the original (SSIM, 1 = identical); above
# about 0.99 it's hard to tell apart.
SOCCER_GPU_QP=22   #  73 MB/min, match 0.990
# SOCCER_GPU_QP=16 # 152 MB/min, match 0.995
# SOCCER_GPU_QP=18 # 116 MB/min, match 0.994
# SOCCER_GPU_QP=20 #  89 MB/min, match 0.992
# SOCCER_GPU_QP=24 #  58 MB/min, match 0.986
# SOCCER_GPU_QP=27 #  41 MB/min, match 0.979
#
# Used when there's no GPU (or SOCCER_ENCODER=cpu). Same idea: lower = better, bigger.
# The CPU makes smaller files than the GPU at the same match, but takes ~5x longer.
SOCCER_CPU_CRF=20   #  58 MB/min, match 0.990
# SOCCER_CPU_CRF=18 #  77 MB/min, match 0.992
# SOCCER_CPU_CRF=23 #  38 MB/min, match 0.986
# How long the CPU spends per frame. medium takes about as long as the footage
# itself. veryfast is ~2.4x faster but matches less well at the same CRF
# (crf 20: 44 MB/min, match 0.985). slow took 2x as long for no gain here.
SOCCER_CPU_SPEED=medium
# SOCCER_CPU_SPEED=veryfast
